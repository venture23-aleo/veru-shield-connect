# Mainnet deployer for contracts/deploy/mainnet.sh — copy to contracts/.env and fill in.
# contracts/.env is git-ignored. Never commit a real key.

# The account that pays for declare + deploy (≥ 5 STRK on mainnet).
DEPLOYER_ADDRESS=0x
# Its private key. From Ready X: Settings → account → Export private key.
DEPLOYER_PRIVATE_KEY=0x
# Account contract type for sncast: ready (Ready X / Argent X), braavos, or oz (OpenZeppelin).
ACCOUNT_TYPE=ready

# Optional overrides — leave commented unless you know why.
# RPC_URL=https://api.cartridge.gg/x/starknet/mainnet/rpc/v0_10
# POOL_ADDRESS=0x040337b1af3c663e86e333bab5a4b28da8d4652a15a69beee2b677776ffe812a
